{
  "name": "grooveagent",
  "version": "1.0.0",
  "description": "GrooveAgent - Max for Live MIDI Style Transfer Plugin",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules src/node/node_modules/jest/bin/jest.js --config jest.config.js",
    "test:structure": "node --experimental-vm-modules src/node/node_modules/jest/bin/jest.js --config jest.config.js tests/structure",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json}\"",
    "format:check": "prettier --check \"**/*.{js,json}\"",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "keywords": [
    "max-for-live",
    "midi",
    "groove",
    "ableton",
    "llm",
    "style-transfer"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
